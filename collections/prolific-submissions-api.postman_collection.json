        {
          "id": "78990a11-0552-4e7a-9742-c0d0d5f0d612",
          "name": "Request the participant who submitted the response to return their response",
          "request": {
            "name": "Request the participant who submitted the response to return their response",
            "description": {
              "content": "**This is an experimental feature that may be subject to change in the future.** <br/>\nIt offers researchers the ability to ask a participant to return a submission. The return reason must be provided in the request and can be any free text string. <br/> The Prolific UI allows users to select any of the following options:\n* Didn't finish the study\n* Encountered technical problems\n* Withdrew consent\n* Other ( uses the free text input)\n\nThis constructs a message around the reasons provided so there is no need to provide additional text beyond the reasons.\n<img alt=\"Example\" src=\"/assets/img/api/message.png\" />\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "submissions",
                ":id",
                "request-return",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The submission id"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_return_reasons\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
