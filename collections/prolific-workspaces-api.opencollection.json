      "items": [
        {
          "info": {
            "name": "Get all a user's workspaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.prolific.com/api/v1/workspaces/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ]
          },
          "docs": "Gets a list of all workspaces that the user is a member of."
        },
        {
          "info": {
            "name": "Create a workspace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.prolific.com/api/v1/workspaces/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new workspace and adds the user as a Workspace Admin."
        },
        {
          "info": {
            "name": "Get workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.prolific.com/api/v1/workspaces/:workspace_id/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace id"
              }
            ]
          },
          "docs": "Gets a workspace's details"
        },
        {
          "info": {
            "name": "Update a workspace",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.prolific.com/api/v1/workspaces/:workspace_id/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a workspace's details."
        },
        {
          "info": {
            "name": "Get the balance of a workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.prolific.com/api/v1/workspaces/:workspace_id/balance/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace id"
              }
            ]
          },
          "docs": "Provides details of the funds available in the workspace."
