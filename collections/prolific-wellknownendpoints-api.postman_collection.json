                  "value": "application/json"
                }
              ],
              "body": "{\n  \"keys\": [\n    {\n      \"kty\": \"RSA\",\n      \"kid\": \"string\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"use\": \"sig\",\n      \"key_ops\": [\n        \"verify\",\n        \"verify\"\n      ]\n    },\n    {\n      \"kty\": \"RSA\",\n      \"kid\": \"string\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"use\": \"sig\",\n      \"key_ops\": [\n        \"verify\",\n        \"verify\"\n      ]\n    }\n  ]\n}",
