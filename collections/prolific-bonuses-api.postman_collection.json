          "name": "Pay bonuses",
          "request": {
            "name": "Pay bonuses",
            "description": {
              "content": "Bonus payments are made asynchronously.\nThe payment will be done in the following minutes and your balance will be updated accordingly.\n\n<Warning>\nThis endpoint is **not idempotent**. Sending multiple requests with the same bulk bonus payment ID will result in participants being paid multiple times. Ensure you send this request only once per bulk payment.\n</Warning>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "bulk-bonus-payments",
                ":id",
                "pay",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
